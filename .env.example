# BARGAINKART Environment Configuration
# Rename this file to .env for custom deployment overrides

SECRET_KEY=bargainkart-secure-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Connection (SQLite by default, uncomment for PostgreSQL or MongoDB)
DATABASE_URL=sqlite:///database/bargainkart.db
# DATABASE_URL=postgresql://username:password@localhost:5432/bargainkart_db

# MongoDB Connection (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/bargainkart
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/bargainkart?retryWrites=true&w=majority
MONGO_DB_NAME=bargainkart

# Google Gemini Generative AI API (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
